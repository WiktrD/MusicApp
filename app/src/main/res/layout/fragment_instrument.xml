<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_gradient"
        tools:layout_editor_absoluteX="-98dp"
        tools:layout_editor_absoluteY="-182dp">


        <Button
            android:id="@+id/instrument_xylofon_button"
            android:layout_width="186dp"
            android:layout_height="59dp"
            android:background="@drawable/button_style"
            android:fontFamily="@font/urban_font"
            android:text="@string/xylofon_string"
            android:textSize="26sp"
            app:layout_constraintBottom_toTopOf="@+id/instrument_organs_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.515"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/instrument_piano_button"
            app:layout_constraintWidth_percent="0.7" />

        <Button
            android:id="@+id/instrument_piano_button"
            android:layout_width="180dp"
            android:layout_height="57dp"
            android:layout_marginTop="408dp"
            android:background="@drawable/button_style"
            android:fontFamily="@font/urban_font"
            android:text="Pianino"
            android:textSize="26sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.502"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.7" />

        <Button
            android:id="@+id/instrument_organs_button"
            android:layout_width="191dp"
            android:layout_height="54dp"
            android:background="@drawable/button_style"
            android:fontFamily="@font/urban_font"
            android:text="@string/organs_string"
            android:textSize="26sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/instrument_piano_button"
            app:layout_constraintVertical_bias="0.57"
            app:layout_constraintWidth_percent="0.7" />

        <Button
            android:id="@+id/language_ger"
            android:layout_width="87dp"
            android:layout_height="54dp"
            android:background="@drawable/button_style"
            android:fontFamily="@font/urban_font"
            android:text="ger"
            android:textSize="26sp"
            app:layout_constraintEnd_toStartOf="@+id/instrument_organs_button"
            app:layout_constraintHorizontal_bias="0.375"
            app:layout_constraintStart_toEndOf="@+id/instrument_piano_button"
            app:layout_constraintWidth_percent="0.7" />

        <TextView
            android:id="@+id/language_choice"
            android:layout_width="256dp"
            android:layout_height="67dp"
            android:fontFamily="@font/urban_font"
            android:gravity="center"
            android:text="@string/instrument_string"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.448" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/logo_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/atmusic"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp"/>

    <TextView
        android:id="@+id/footer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Created by Dziker and Wojtas"
        android:textSize="14sp"
        android:textColor="#B5BEC8"
        android:textStyle="italic"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
